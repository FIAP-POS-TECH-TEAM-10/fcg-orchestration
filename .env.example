# Copie para .env (ignorado pelo git) e preencha. Nunca commite valores.
# Formato CHAVE=valor, sem aspas; o docker-compose, o eks-up.sh e o REST Client leem este arquivo.
# Cada leitor trata caracteres especiais de um jeito: para as senhas use letras, números e - _ . @ #
# (evite " \ $ e espaços: o compose interpreta $, e os .http montam JSON com aspas e barra).

# PAT do GitHub com scope read:packages (baixar o pacote privado FCGames.IntegrationEvents).
NUGET_AUTH_TOKEN=

# Chave de assinatura JWT, idêntica nos 3 serviços (mín. 32 caracteres). Só local/docker-compose;
# no EKS o Terraform gera a chave.
JWT_KEY=

# Credenciais do RabbitMQ do docker-compose (só local; na AWS o transporte é SQS/SNS por IAM).
RABBITMQ_USER=
RABBITMQ_PASS=

# Senha do usuário admin@fcgames.com criado pelo users-api na primeira subida. Local: usada pelo
# docker-compose e pelos arquivos .http. EKS: vem do secret do GitHub de mesmo nome.
ADMIN_PASSWORD=

# Senha do admin do Grafana no EKS (o eks-up.sh a lê quando você liga o cluster pela máquina).
GRAFANA_PASSWORD=
